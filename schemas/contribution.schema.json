{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nickhilster/Buy-Local-4-Local/schemas/contribution.schema.json",
  "title": "Buy Local 4 Local Contribution",
  "type": "object",
  "required": ["schema_version", "contribution_id", "created_at", "claims", "privacy_attestation"],
  "properties": {
    "schema_version": {"type": "string"},
    "contribution_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "agent": {
      "type": "object",
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "protocol_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "claim.schema.json"}
    },
    "privacy_attestation": {
      "type": "object",
      "required": ["contains_personal_context", "contains_private_conversation_content"],
      "properties": {
        "contains_personal_context": {"const": false},
        "contains_private_conversation_content": {"const": false},
        "sanitized": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
